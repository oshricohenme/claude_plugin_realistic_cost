{
  "name": "pre_ai_dev_cost_receipt",
  "version": "0.4.0",
  "description": "Estimate what a 100% human-driven engineering team would have cost to produce the work in an AI coding session — across every job function (PM, EM, design, backend, frontend, QA, DevOps, security, data, tech writing) — as a terminal receipt, status line, or exported report.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Oshri Cohen",
    "url": "https://oshricohen.me"
  },
  "homepage": "https://github.com/oshricohenme/claude_plugin_realistic_cost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oshricohenme/claude_plugin_realistic_cost.git"
  },
  "bugs": {
    "url": "https://github.com/oshricohenme/claude_plugin_realistic_cost/issues"
  },
  "bin": {
    "realistic-cost": "./dist/bin/realistic-cost.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "dev": "tsx src/bin/realistic-cost.ts",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm run format && npm test",
    "prepare": "node -e \"process.exit(require('fs').existsSync('.git')?0:1)\" && npm run build || exit 0",
    "prepublishOnly": "npm run check && npm run build",
    "typecheck:opencode": "tsc --noEmit -p tsconfig.opencode.json"
  },
  "files": [
    ".claude-plugin",
    "dist",
    "claude-code",
    "opencode/plugins",
    "opencode/skills",
    "opencode/package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "cost",
    "estimate",
    "engineering",
    "team",
    "plugin",
    "statusline",
    "ai-coding",
    "claude-code-plugin",
    "marketplace"
  ]
}
