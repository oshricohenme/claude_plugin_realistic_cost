{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 2
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/print-cost.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(realistic-cost:*)",
      "Bash(~/.claude/statusline.sh:*)",
      "Bash(~/.claude/print-cost.sh:*)"
    ]
  }
}
